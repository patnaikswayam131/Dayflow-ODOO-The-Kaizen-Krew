    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dayflow/shared": "*",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.11"
