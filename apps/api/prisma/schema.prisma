// ─── Prisma Schema for Dayflow HRMS ───
// Source of truth: /docs/Dayflow_schema.sql
// Adapted for SQLite embedded database (zero external dependencies).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── COMPANIES ───

model companies {
  id                       String   @id @default(uuid())
  name                     String
  login_prefix             String
  logo_url                 String?
  working_days_per_week    Int      @default(5)
  break_time_minutes       Int      @default(60)
  standard_work_hours      Float    @default(8.00)
  half_day_threshold_hours Float    @default(4.00)
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now())

  users              users[]
  leave_types        leave_types[]
  login_id_sequences login_id_sequences[]
}

// ─── USERS ───

model users {
  id                   String   @id @default(uuid())
  company_id           String
  login_id             String   @unique
  emp_code             String   @unique
  email                String   @unique
  personal_email       String?
  password_hash        String
  must_change_password Boolean  @default(true)
  role                 String   @default("EMPLOYEE")
  status               String   @default("ACTIVE")

  first_name       String
  last_name        String
  phone            String?
  avatar_url       String?

  department       String?
  job_position     String?
  manager_id       String?
  location         String?
  date_of_joining  DateTime

  // Private Info
  date_of_birth    DateTime?
  residing_address String?
  nationality      String?
  gender           String?
  marital_status   String?
  pan_no           String?
  uan_no           String?

  // Resume
  about            String?
  job_love_text    String?
  interests        String?

  // Email verification
  email_verified   Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // Relations
  company      companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  manager      users?    @relation("ManagerSubordinates", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates users[]   @relation("ManagerSubordinates")

  bank_details              bank_details?
  skills                    skills[]
  certifications            certifications[]
  attendance_records        attendance_records[]
  leave_requests            leave_requests[]     @relation("UserLeaveRequests")
  reviewed_requests         leave_requests[]     @relation("ReviewerLeaveRequests")
  leave_balances            leave_balances[]
  salary_structures         salary_structures[]
  audit_logs                audit_logs[]
  refresh_tokens            refresh_tokens[]
  email_verification_tokens email_verification_tokens[]

  @@index([company_id])
  @@index([login_id])
  @@index([email])
}

// ─── LOGIN ID SEQUENCES ───

model login_id_sequences {
  company_id   String
  joining_year Int
  next_seq     Int @default(1)

  company companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([company_id, joining_year])
}

// ─── BANK DETAILS (1:1 with users) ───

model bank_details {
  user_id        String   @id
  account_number String
  bank_name      String?
  ifsc_code      String?
  updated_at     DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ─── SKILLS ───

model skills {
  id      String @id @default(uuid())
  user_id String
  name    String

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ─── CERTIFICATIONS ───

model certifications {
  id        String    @id @default(uuid())
  user_id   String
  name      String
  issued_by String?
  issued_on DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ─── ATTENDANCE ───

model attendance_records {
  id           String    @id @default(uuid())
  user_id      String
  date         DateTime
  check_in_at  DateTime?
  check_out_at DateTime?
  work_hours   Float?
  extra_hours  Float?
  status       String    @default("ABSENT")
  created_at   DateTime  @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([user_id, date])
  @@index([date])
}

// ─── LEAVE TYPES ───

model leave_types {
  id                      String  @id @default(uuid())
  company_id              String
  name                    String
  is_paid                 Boolean @default(true)
  requires_attachment     Boolean @default(false)
  default_allocation_days Float   @default(0)

  company        companies        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leave_balances leave_balances[]
  leave_requests leave_requests[]

  @@unique([company_id, name])
}

// ─── LEAVE BALANCES ───

model leave_balances {
  id             String @id @default(uuid())
  user_id        String
  leave_type_id  String
  year           Int
  allocated_days Float  @default(0)
  used_days      Float  @default(0)

  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leave_type leave_types @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, leave_type_id, year])
}

// ─── LEAVE REQUESTS ───

model leave_requests {
  id             String    @id @default(uuid())
  user_id        String
  leave_type_id  String
  start_date     DateTime
  end_date       DateTime
  days_requested Float
  remarks        String?
  attachment_url String?
  status         String    @default("PENDING")
  reviewed_by    String?
  reviewed_at    DateTime?
  review_comment String?
  created_at     DateTime  @default(now())

  user       users       @relation("UserLeaveRequests", fields: [user_id], references: [id], onDelete: Cascade)
  leave_type leave_types @relation(fields: [leave_type_id], references: [id])
  reviewer   users?      @relation("ReviewerLeaveRequests", fields: [reviewed_by], references: [id])

  @@index([user_id, status])
  @@index([start_date, end_date])
}

// ─── SALARY STRUCTURES ───

model salary_structures {
  id             String   @id @default(uuid())
  user_id        String
  monthly_wage   Float
  wage_type      String   @default("FIXED")
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  user              users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  salary_components salary_components[]

  @@index([user_id])
}

// ─── SALARY COMPONENTS ───

model salary_components {
  id                  String  @id @default(uuid())
  salary_structure_id String
  component_key       String
  computation_type    String
  percentage_base     String?
  configured_value    Float
  computed_amount     Float

  salary_structure salary_structures @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)

  @@unique([salary_structure_id, component_key])
}

// ─── AUDIT LOGS ───

model audit_logs {
  id            String   @id @default(uuid())
  actor_user_id String?
  action        String
  entity        String
  entity_id     String?
  metadata      String?
  created_at    DateTime @default(now())

  actor users? @relation(fields: [actor_user_id], references: [id])

  @@index([entity, entity_id])
}

// ─── REFRESH TOKENS ───

model refresh_tokens {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ─── EMAIL VERIFICATION TOKENS ───

model email_verification_tokens {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
