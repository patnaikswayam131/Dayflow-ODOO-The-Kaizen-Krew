// ─── Prisma Schema for Dayflow HRMS ───
// Source of truth: /docs/Dayflow_schema.sql
// Every table name, column name, enum, relation, and index matches the SQL exactly.
// Do NOT rename columns or restructure tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───

enum user_role {
  ADMIN
  HR_OFFICER
  EMPLOYEE
}

enum user_status {
  ACTIVE
  INACTIVE
}

enum attendance_status {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum leave_status {
  PENDING
  APPROVED
  REJECTED
}

enum computation_type {
  FIXED_AMOUNT
  PERCENTAGE
}

enum percentage_base {
  WAGE
  BASIC
}

enum salary_component_key {
  BASIC
  HRA
  STANDARD_ALLOWANCE
  PERFORMANCE_BONUS
  LTA
  FIXED_ALLOWANCE
  PROFESSIONAL_TAX
  PF_EMPLOYEE
  PF_EMPLOYER
}

// ─── COMPANIES ───

model companies {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String   @db.VarChar(255)
  login_prefix          String   @db.VarChar(4)
  logo_url              String?
  working_days_per_week Int      @default(5) @db.SmallInt
  break_time_minutes    Int      @default(60) @db.SmallInt
  standard_work_hours   Decimal  @default(8.00) @db.Decimal(4, 2)
  half_day_threshold_hours Decimal @default(4.00) @db.Decimal(4, 2)
  created_at            DateTime @default(now()) @db.Timestamptz()
  updated_at            DateTime @default(now()) @db.Timestamptz()

  users               users[]
  leave_types          leave_types[]
  login_id_sequences   login_id_sequences[]
}

// ─── USERS ───

model users {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id           String      @db.Uuid
  login_id             String      @unique @db.VarChar(32)
  emp_code             String      @unique @db.VarChar(32)
  email                String      @unique
  personal_email       String?
  password_hash        String
  must_change_password Boolean     @default(true)
  role                 user_role   @default(EMPLOYEE)
  status               user_status @default(ACTIVE)

  first_name           String      @db.VarChar(100)
  last_name            String      @db.VarChar(100)
  phone                String?     @db.VarChar(20)
  avatar_url           String?

  department           String?     @db.VarChar(100)
  job_position         String?     @db.VarChar(100)
  manager_id           String?     @db.Uuid
  location             String?     @db.VarChar(150)
  date_of_joining      DateTime    @db.Date

  // Private Info
  date_of_birth        DateTime?   @db.Date
  residing_address     String?
  nationality          String?     @db.VarChar(100)
  gender               String?     @db.VarChar(30)
  marital_status       String?     @db.VarChar(30)
  pan_no               String?     @db.VarChar(20)
  uan_no               String?     @db.VarChar(20)

  // Resume
  about                String?
  job_love_text        String?
  interests            String?

  // Email verification (FR-1 — bootstrap admin must verify before login)
  email_verified       Boolean     @default(false)

  created_at           DateTime    @default(now()) @db.Timestamptz()
  updated_at           DateTime    @default(now()) @db.Timestamptz()

  // Relations
  company              companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  manager              users?      @relation("ManagerSubordinates", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates         users[]     @relation("ManagerSubordinates")

  bank_details         bank_details?
  skills               skills[]
  certifications       certifications[]
  attendance_records   attendance_records[]
  leave_requests       leave_requests[]        @relation("UserLeaveRequests")
  reviewed_requests    leave_requests[]         @relation("ReviewerLeaveRequests")
  leave_balances       leave_balances[]
  salary_structures    salary_structures[]
  audit_logs           audit_logs[]
  refresh_tokens       refresh_tokens[]
  email_verification_tokens email_verification_tokens[]

  @@index([company_id], name: "idx_users_company")
  @@index([login_id], name: "idx_users_login_id")
  @@index([email], name: "idx_users_email")
}

// ─── LOGIN ID SEQUENCES ───

model login_id_sequences {
  company_id   String @db.Uuid
  joining_year Int    @db.SmallInt
  next_seq     Int    @default(1)

  company      companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([company_id, joining_year])
}

// ─── BANK DETAILS (1:1 with users) ───

model bank_details {
  user_id        String   @id @db.Uuid
  account_number String
  bank_name      String?  @db.VarChar(150)
  ifsc_code      String?  @db.VarChar(20)
  updated_at     DateTime @default(now()) @db.Timestamptz()

  user           users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ─── SKILLS ───

model skills {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  name    String @db.VarChar(100)

  user    users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_skills_user")
}

// ─── CERTIFICATIONS ───

model certifications {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String    @db.Uuid
  name      String    @db.VarChar(200)
  issued_by String?   @db.VarChar(200)
  issued_on DateTime? @db.Date

  user      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_certifications_user")
}

// ─── ATTENDANCE ───

model attendance_records {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String            @db.Uuid
  date        DateTime          @db.Date
  check_in_at DateTime?         @db.Timestamptz()
  check_out_at DateTime?        @db.Timestamptz()
  work_hours  Decimal?          @db.Decimal(5, 2)
  extra_hours Decimal?          @db.Decimal(5, 2)
  status      attendance_status @default(ABSENT)
  created_at  DateTime          @default(now()) @db.Timestamptz()

  user        users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([user_id, date], name: "idx_attendance_user_date")
  @@index([date], name: "idx_attendance_date")
}

// ─── LEAVE TYPES ───

model leave_types {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String   @db.Uuid
  name                    String   @db.VarChar(50)
  is_paid                 Boolean  @default(true)
  requires_attachment     Boolean  @default(false)
  default_allocation_days Decimal  @default(0) @db.Decimal(5, 2)

  company                 companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leave_balances          leave_balances[]
  leave_requests          leave_requests[]

  @@unique([company_id, name])
}

// ─── LEAVE BALANCES ───

model leave_balances {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  leave_type_id  String   @db.Uuid
  year           Int      @db.SmallInt
  allocated_days Decimal  @default(0) @db.Decimal(5, 2)
  used_days      Decimal  @default(0) @db.Decimal(5, 2)

  user           users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leave_type     leave_types @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, leave_type_id, year])
}

// ─── LEAVE REQUESTS ───

model leave_requests {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String       @db.Uuid
  leave_type_id  String       @db.Uuid
  start_date     DateTime     @db.Date
  end_date       DateTime     @db.Date
  days_requested Decimal      @db.Decimal(5, 2)
  remarks        String?
  attachment_url String?
  status         leave_status @default(PENDING)
  reviewed_by    String?      @db.Uuid
  reviewed_at    DateTime?    @db.Timestamptz()
  review_comment String?
  created_at     DateTime     @default(now()) @db.Timestamptz()

  user           users        @relation("UserLeaveRequests", fields: [user_id], references: [id], onDelete: Cascade)
  leave_type     leave_types  @relation(fields: [leave_type_id], references: [id])
  reviewer       users?       @relation("ReviewerLeaveRequests", fields: [reviewed_by], references: [id])

  @@index([user_id, status], name: "idx_leave_requests_user_status")
  @@index([start_date, end_date], name: "idx_leave_requests_dates")
}

// ─── SALARY STRUCTURES ───

model salary_structures {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  monthly_wage  Decimal  @db.Decimal(12, 2)
  wage_type     String   @default("FIXED") @db.VarChar(20)
  effective_from DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @default(now()) @db.Timestamptz()

  user          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  salary_components salary_components[]

  @@index([user_id], name: "idx_salary_structures_user")
}

// ─── SALARY COMPONENTS ───

model salary_components {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salary_structure_id String               @db.Uuid
  component_key       salary_component_key
  computation_type    computation_type
  percentage_base     percentage_base?
  configured_value    Decimal              @db.Decimal(12, 4)
  computed_amount     Decimal              @db.Decimal(12, 2)

  salary_structure    salary_structures    @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)

  @@unique([salary_structure_id, component_key])
}

// ─── AUDIT LOGS ───

model audit_logs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(100)
  entity        String   @db.VarChar(100)
  entity_id     String?  @db.Uuid
  metadata      Json?
  created_at    DateTime @default(now()) @db.Timestamptz()

  actor         users?   @relation(fields: [actor_user_id], references: [id])

  @@index([entity, entity_id], name: "idx_audit_logs_entity")
}

// ─── REFRESH TOKENS ───

model refresh_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String
  expires_at DateTime @db.Timestamptz()
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz()

  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_refresh_tokens_user")
}

// ─── EMAIL VERIFICATION TOKENS (FR-1 — bootstrap admin email verification) ───

model email_verification_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String
  expires_at DateTime @db.Timestamptz()
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz()

  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_email_verification_tokens_user")
}
